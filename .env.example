# ==============================================
# AXON — Environment Configuration
# ==============================================
# These are HOST-SIDE DEFAULTS. Users can override
# via BYOK (Bring Your Own Key) in the app's settings.
# Everything is stored locally — see localStore.js.
# ==============================================

# --- Groq (Default LLM Key) ---
GROQ_API_KEY=gsk_your_default_groq_key_here

# --- Trial key (zero-setup first run) ---
# Fallback used only if neither the user nor GROQ_API_KEY above
# provides a key. Leave unset unless you're distributing a trial build.
AXON_TRIAL_GROQ_API_KEY=

# --- Groq Model IDs ---
GROQ_MODEL_TRIAGE=llama3-8b-8192
GROQ_MODEL_TRANSLATE=llama3-70b-8192

# --- Resend (Email fallback for WUPHF/Gargoyle) ---
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=safety@yourdomain.com

# --- Web Push (VAPID keys) ---
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Security ---
AUTH_SECRET=your_random_auth_secret_min_32_chars
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GARGOYLE_COOLDOWN_SECONDS=300
